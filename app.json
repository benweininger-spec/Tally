{
  "expo": {
    "name": "Tacoma Dash",
    "slug": "tacoma-dash",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0a07",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benji.tacomadash"
    },
    "android": {
      "package": "com.benji.tacomadash",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Tacoma Dash uses GPS to show live speed, heading, altitude, and trip."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Tacoma Dash uses motion sensors to show g-force, pitch, and roll."
        }
      ],
      "expo-dev-client",
      "./plugins/withBluetoothClassic",
      "./plugins/withRadioQueries",
      "./plugins/withCarPlayQueries",
      "./plugins/withHomeLauncher",
      "./plugins/withLauncherQueries"
    ]
  }
}
